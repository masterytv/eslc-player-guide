# Shared password for staff. Logging in with it unlocks editing.
ADMIN_PASSWORD=

# Starting team passcode for players. Admins can change it from the app
# (More → Passcodes); after that, the app's value wins and this one is ignored.
VIEWER_PASSWORD=

# Random string of at least 32 characters used to sign login cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres connection string (the pooled one, host contains -pooler).
# On Vercel the Neon integration sets this for you.
# Leave it unset locally to store content in ./.data instead.
DATABASE_URL=
